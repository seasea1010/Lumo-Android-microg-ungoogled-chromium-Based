+
+/**
+ * Client for the microG "Folsom" key retrieval service (the GMS trusted vault backend).
+ *
+ * <p>The service is not bound directly: binding to {@code
+ * com.google.android.gms.auth.key.retrieval.service.START} returns a GMS service broker binder,
+ * and the actual {@link IKeyRetrievalService} is obtained through a broker handshake ({@link
+ * IGmsServiceBroker#getService}) with service id 172 and a {@code SECURITY_DOMAIN} extra of
+ * {@code "chromesync"} in the request. Without that extra the service refuses the handshake.
+ *
+ * <p>All state is confined to the main thread. Binder callbacks are posted to the main thread
+ * before touching any state, and every operation completes its {@link Promise} on the main
+ * thread, where the trusted vault backend's callers live. Operations never throw: failures are
+ * reported as empty/false results (or a rejected promise where the backend contract expects
+ * one), and every operation has a timeout so a hung service cannot block sync forever.
+ *
+ * <p>Key material is never logged; only key counts and versions are.
+ */
+final class FolsomClient {
+    private static final String TAG = "FolsomClient";
+
+    private static final String ACTION_KEY_RETRIEVAL =
+            "com.google.android.gms.auth.key.retrieval.service.START";
+    private static final String PACKAGE_MORPHE_MICROG = "app.revanced.android.gms";
+    private static final String PACKAGE_MICROG = "com.google.android.gms";
+    private static final String[] GMS_PACKAGES = {PACKAGE_MORPHE_MICROG, PACKAGE_MICROG};
+
+    private static final int SERVICE_ID_FOLSOM = 172;
+    private static final String EXTRA_SECURITY_DOMAIN = "SECURITY_DOMAIN";
+    private static final String SECURITY_DOMAIN = "chromesync";
+
+    // startUxFlow type used by the service itself when it builds a key retrieval intent for
+    // getKeyMaterial errors (operation type 1 = key retrieval).
+    private static final int UX_FLOW_TYPE_KEY_RETRIEVAL = 1;
+
+    private static final long TIMEOUT_MS = 30000;
+
+    private static FolsomClient sInstance;
+
+    static FolsomClient getInstance() {
+        if (sInstance == null) {
+            sInstance = new FolsomClient();
+        }
+        return sInstance;
+    }
+
+    private final Handler mMainHandler = new Handler(Looper.getMainLooper());
+
+    // Everything below is confined to the main thread.
+    private IKeyRetrievalService mService;
+    private IBinder mServiceBinder;
+    private ServiceConnection mBrokerConnection;
+    private boolean mConnecting;
+    private int mConnectGeneration;
+    private final List<ConnectionWaiter> mConnectionWaiters = new ArrayList<>();
+    private final Map<String, PendingOp<List<byte[]>>> mFetchInFlight = new HashMap<>();
+    private String mLastRetrievalIntentAccount;
+    private PendingIntent mLastRetrievalIntent;
+
+    private FolsomClient() {}
+
+    private interface ConnectionWaiter {
+        void onConnected(IKeyRetrievalService service);
+
+        void onConnectionFailed();
+    }
+
+    /** An operation in progress; completes its promise at most once, on the main thread. */
+    private class PendingOp<T> {
+        final Promise<T> promise = new Promise<>();
+        private final Runnable mOnDone;
+        private boolean mDone;
+
+        PendingOp(Runnable onDone) {
+            mOnDone = onDone;
+            mMainHandler.postDelayed(mTimeoutRunnable, TIMEOUT_MS);
+        }
+
+        private final Runnable mTimeoutRunnable =
+                () -> {
+                    if (markDone()) {
+                        onTimeout();
+                    }
+                };
+
+        /** Subclass hook invoked (once) when the operation times out. */
+        void onTimeout() {}
+
+        boolean isDone() {
+            return mDone;
+        }
+
+        private boolean markDone() {
+            if (mDone) return false;
+            mDone = true;
+            mMainHandler.removeCallbacks(mTimeoutRunnable);
+            if (mOnDone != null) mOnDone.run();
+            return true;
+        }
+
+        void complete(T value) {
+            if (markDone() && promise.isPending()) {
+                promise.fulfill(value);
+            }
+        }
+
+        void fail(Exception e) {
+            if (markDone() && promise.isPending()) {
+                promise.reject(e);
+            }
+        }
+    }
+
+    private void runOnMain(Runnable runnable) {
+        if (Looper.myLooper() == Looper.getMainLooper()) {
+            runnable.run();
+        } else {
+            mMainHandler.post(runnable);
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Public operations
+    // ---------------------------------------------------------------------------------------------
+
+    /**
+     * Fetches the shared keys for {@code email}. Always fulfills: on any failure (service
+     * unavailable, error status, timeout) the result is an empty list, matching the backend
+     * contract that an empty result simply means "no keys available right now".
+     */
+    Promise<List<byte[]>> fetchKeys(final String email) {
+        PendingOp<List<byte[]>> inFlight = mFetchInFlight.get(email);
+        if (inFlight != null && !inFlight.isDone()) {
+            return inFlight.promise;
+        }
+        final PendingOp<List<byte[]>> op =
+                new PendingOp<List<byte[]>>(() -> mFetchInFlight.remove(email)) {
+                    @Override
+                    void onTimeout() {
+                        Log.w(TAG, "fetchKeys timed out");
+                        if (promise.isPending()) {
+                            promise.fulfill(Collections.emptyList());
+                        }
+                    }
+                };
+        mFetchInFlight.put(email, op);
+        runOnMain(
+                () ->
+                        ensureConnected(
+                                new ConnectionWaiter() {
+                                    @Override
+                                    public void onConnected(IKeyRetrievalService service) {
+                                        if (op.isDone()) return;
+                                        callGetKeyMaterial(op, service, email);
+                                    }
+
+                                    @Override
+                                    public void onConnectionFailed() {
+                                        op.complete(Collections.emptyList());
+                                    }
+                                }));
+        return op.promise;
+    }
+
+    /**
+     * Asks the service for the key retrieval (re-authentication) flow intent. Rejects when no
+     * intent can be produced.
+     */
+    Promise<PendingIntent> createKeyRetrievalIntent(final String email) {
+        final PendingOp<PendingIntent> op = new PendingOp<>(null) {
+            @Override
+            void onTimeout() {
+                Log.w(TAG, "createKeyRetrievalIntent timed out");
+                completeFromFallbackOrFail(email, this);
+            }
+        };
+        runOnMain(
+                () ->
+                        ensureConnected(
+                                new ConnectionWaiter() {
+                                    @Override
+                                    public void onConnected(IKeyRetrievalService service) {
+                                        if (op.isDone()) return;
+                                        callStartUxFlow(op, service, email);
+                                    }
+
+                                    @Override
+                                    public void onConnectionFailed() {
+                                        completeFromFallbackOrFail(email, op);
+                                    }
+                                }));
+        return op.promise;
+    }
+
+    /** Marks the locally cached keys for {@code email} as stale. Always fulfills. */
+    Promise<Boolean> markLocalKeysAsStale(final String email) {
+        final PendingOp<Boolean> op =
+                new PendingOp<Boolean>(null) {
+                    @Override
+                    void onTimeout() {
+                        Log.w(TAG, "markLocalKeysAsStale timed out");
+                        if (promise.isPending()) {
+                            promise.fulfill(false);
+                        }
+                    }
+                };
+        runOnMain(
+                () ->
+                        ensureConnected(
+                                new ConnectionWaiter() {
+                                    @Override
+                                    public void onConnected(IKeyRetrievalService service) {
+                                        if (op.isDone()) return;
+                                        callMarkLocalKeysAsStale(op, service, email);
+                                    }
+
+                                    @Override
+                                    public void onConnectionFailed() {
+                                        op.complete(false);
+                                    }
+                                }));
+        return op.promise;
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Service calls (main thread)
+    // ---------------------------------------------------------------------------------------------
+
+    private void callGetKeyMaterial(
+            final PendingOp<List<byte[]>> op, IKeyRetrievalService service, final String email) {
+        ISharedKeyCallback callback =
+                new ISharedKeyCallback.Stub() {
+                    @Override
+                    public void onResult(final Status status, final SharedKey[] keys) {
+                        runOnMain(() -> handleGetKeyMaterialResult(op, email, status, keys));
+                    }
+                };
+        try {
+            service.getKeyMaterial(callback, email, null);
+        } catch (RemoteException e) {
+            Log.w(TAG, "getKeyMaterial failed", e);
+            op.complete(Collections.emptyList());
+        }
+    }
+
+    private void handleGetKeyMaterialResult(
+            PendingOp<List<byte[]>> op, String email, Status status, SharedKey[] keys) {
+        if (status != null && status.hasResolution()) {
+            // Remember the retrieval intent: createKeyRetrievalIntent can fall back to it.
+            mLastRetrievalIntentAccount = email;
+            mLastRetrievalIntent = status.getResolution();
+        }
+        if (status == null || !status.isSuccess() || keys == null) {
+            if (status != null) {
+                Log.w(
+                        TAG,
+                        "getKeyMaterial returned status "
+                                + status.getStatusCode()
+                                + ": "
+                                + status.getStatusMessage());
+            }
+            op.complete(Collections.emptyList());
+            return;
+        }
+        List<SharedKey> usable = new ArrayList<>();
+        for (SharedKey key : keys) {
+            if (key != null && key.key > 0 && key.keyMaterial != null && key.keyMaterial.length > 0) {
+                usable.add(key);
+            }
+        }
+        // The trusted vault contract expects the keys in version order, latest last.
+        Collections.sort(usable, (a, b) -> Integer.compare(a.key, b.key));
+        List<byte[]> result = new ArrayList<>(usable.size());
+        for (SharedKey key : usable) {
+            result.add(key.keyMaterial);
+        }
+        Log.i(TAG, "getKeyMaterial returned " + result.size() + " keys");
+        op.complete(result);
+    }
+
+    private void callStartUxFlow(
+            final PendingOp<PendingIntent> op, IKeyRetrievalService service, final String email) {
+        IKeyRetrievalCallback callback =
+                new IKeyRetrievalCallback.Stub() {
+                    @Override
+                    public void onResult(final Status status) {
+                        runOnMain(
+                                () -> {
+                                    PendingIntent intent =
+                                            status != null ? status.getResolution() : null;
+                                    if (intent != null) {
+                                        op.complete(intent);
+                                    } else {
+                                        completeFromFallbackOrFail(email, op);
+                                    }
+                                });
+                    }
+                };
+        try {
+            service.startUxFlow(callback, email, UX_FLOW_TYPE_KEY_RETRIEVAL, null);
+        } catch (RemoteException e) {
+            Log.w(TAG, "startUxFlow failed", e);
+            completeFromFallbackOrFail(email, op);
+        }
+    }
+
+    private void completeFromFallbackOrFail(String email, PendingOp<PendingIntent> op) {
+        if (email.equals(mLastRetrievalIntentAccount) && mLastRetrievalIntent != null) {
+            op.complete(mLastRetrievalIntent);
+        } else {
+            op.fail(new Exception("No key retrieval intent available"));
+        }
+    }
+
+    private void callMarkLocalKeysAsStale(
+            final PendingOp<Boolean> op, IKeyRetrievalService service, String email) {
+        IKeyRetrievalCallback callback =
+                new IKeyRetrievalCallback.Stub() {
+                    @Override
+                    public void onResult(final Status status) {
+                        runOnMain(
+                                () ->
+                                        op.complete(
+                                                status != null && status.isSuccess()));
+                    }
+                };
+        try {
+            service.markLocalKeysAsStale(callback, email, null);
+        } catch (RemoteException e) {
+            Log.w(TAG, "markLocalKeysAsStale failed", e);
+            op.complete(false);
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Connection management (main thread)
+    // ---------------------------------------------------------------------------------------------
+
+    private void ensureConnected(ConnectionWaiter waiter) {
+        if (mService != null) {
+            waiter.onConnected(mService);
+            return;
+        }
+        mConnectionWaiters.add(waiter);
+        if (mConnecting) return;
+        mConnecting = true;
+        mMainHandler.postDelayed(mConnectWatchdog, TIMEOUT_MS);
+        tryConnectToPackage(0);
+    }
+
+    private final Runnable mConnectWatchdog =
+            () -> {
+                if (!mConnecting || mService != null) return;
+                Log.w(TAG, "Connection attempt timed out");
+                teardownConnection();
+                failConnectionWaiters();
+            };
+
+    private void tryConnectToPackage(final int packageIndex) {
+        if (packageIndex >= GMS_PACKAGES.length) {
+            mConnecting = false;
+            mMainHandler.removeCallbacks(mConnectWatchdog);
+            failConnectionWaiters();
+            return;
+        }
+        // Abandon any previous attempt: unbind it and invalidate its callbacks.
+        unbindBrokerConnection();
+        final int generation = ++mConnectGeneration;
+        final Context context = ContextUtils.getApplicationContext();
+        Intent intent = new Intent(ACTION_KEY_RETRIEVAL).setPackage(GMS_PACKAGES[packageIndex]);
+        ServiceConnection connection =
+                new ServiceConnection() {
+                    @Override
+                    public void onServiceConnected(ComponentName name, IBinder binder) {
+                        if (generation != mConnectGeneration) return;
+                        startBrokerHandshake(packageIndex, generation, binder);
+                    }
+
+                    @Override
+                    public void onServiceDisconnected(ComponentName name) {
+                        handleServiceDisconnected();
+                    }
+                };
+        mBrokerConnection = connection;
+        boolean accepted = false;
+        try {
+            accepted = context.bindService(intent, connection, Context.BIND_AUTO_CREATE);
+        } catch (Exception e) {
+            Log.w(TAG, "bindService failed for " + GMS_PACKAGES[packageIndex], e);
+        }
+        if (!accepted) {
+            mBrokerConnection = null;
+            tryConnectToPackage(packageIndex + 1);
+        }
+    }
+
+    private void unbindBrokerConnection() {
+        if (mBrokerConnection != null) {
+            try {
+                ContextUtils.getApplicationContext().unbindService(mBrokerConnection);
+            } catch (Exception ignored) {
+                // Already unbound.
+            }
+            mBrokerConnection = null;
+        }
+    }
+
+    private void startBrokerHandshake(
+            final int packageIndex, final int generation, IBinder brokerBinder) {
+        IGmsServiceBroker broker = IGmsServiceBroker.Stub.asInterface(brokerBinder);
+        if (broker == null) {
+            tryConnectToPackage(packageIndex + 1);
+            return;
+        }
+        Context context = ContextUtils.getApplicationContext();
+        GetServiceRequest request = new GetServiceRequest(SERVICE_ID_FOLSOM);
+        request.packageName = context.getPackageName();
+        Bundle extras = new Bundle();
+        extras.putString(EXTRA_SECURITY_DOMAIN, SECURITY_DOMAIN);
+        request.extras = extras;
+        try {
+            broker.getService(
+                    new IGmsCallbacks.Stub() {
+                        @Override
+                        public void onPostInitComplete(
+                                int statusCode, IBinder binder, Bundle params) {
+                            runOnMain(
+                                    () -> {
+                                        if (generation != mConnectGeneration) return;
+                                        handleHandshakeResult(packageIndex, statusCode, binder);
+                                    });
+                        }
+
+                        @Override
+                        public void onAccountValidationComplete(int statusCode, Bundle params) {
+                            // Not used by this handshake.
+                        }
+
+                        @Override
+                        public void onPostInitCompleteWithConnectionInfo(
+                                int statusCode, IBinder binder, ConnectionInfo info) {
+                            runOnMain(
+                                    () -> {
+                                        if (generation != mConnectGeneration) return;
+                                        handleHandshakeResult(packageIndex, statusCode, binder);
+                                    });
+                        }
+                    },
+                    request);
+        } catch (RemoteException e) {
+            Log.w(TAG, "Broker handshake failed", e);
+            tryConnectToPackage(packageIndex + 1);
+        }
+    }
+
+    private void handleHandshakeResult(int packageIndex, int statusCode, IBinder binder) {
+        if (!mConnecting) {
+            // Stale callback (e.g. after the watchdog tore the attempt down).
+            return;
+        }
+        if (statusCode != 0 || binder == null) {
+            Log.w(TAG, "Broker handshake refused with status " + statusCode);
+            tryConnectToPackage(packageIndex + 1);
+            return;
+        }
+        IKeyRetrievalService service = IKeyRetrievalService.Stub.asInterface(binder);
+        if (service == null) {
+            tryConnectToPackage(packageIndex + 1);
+            return;
+        }
+        mService = service;
+        mServiceBinder = binder;
+        mConnecting = false;
+        mMainHandler.removeCallbacks(mConnectWatchdog);
+        try {
+            binder.linkToDeath(
+                    () ->
+                            runOnMain(
+                                    () -> {
+                                        Log.w(TAG, "Folsom service binder died");
+                                        mService = null;
+                                        mServiceBinder = null;
+                                    }),
+                    0);
+        } catch (RemoteException ignored) {
+            // The binder is already dead; the next call will fail and reconnect.
+            mService = null;
+            mServiceBinder = null;
+            failConnectionWaiters();
+            return;
+        }
+        List<ConnectionWaiter> waiters = new ArrayList<>(mConnectionWaiters);
+        mConnectionWaiters.clear();
+        for (ConnectionWaiter waiter : waiters) {
+            waiter.onConnected(service);
+        }
+    }
+
+    private void handleServiceDisconnected() {
+        mService = null;
+        mServiceBinder = null;
+    }
+
+    private void teardownConnection() {
+        mConnectGeneration++;
+        unbindBrokerConnection();
+        mConnecting = false;
+        mMainHandler.removeCallbacks(mConnectWatchdog);
+    }
+
+    private void failConnectionWaiters() {
+        List<ConnectionWaiter> waiters = new ArrayList<>(mConnectionWaiters);
+        mConnectionWaiters.clear();
+        for (ConnectionWaiter waiter : waiters) {
+            waiter.onConnectionFailed();
+        }
+    }
+}
