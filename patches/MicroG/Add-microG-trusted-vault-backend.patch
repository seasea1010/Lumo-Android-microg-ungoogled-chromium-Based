+/*
+ * SPDX-FileCopyrightText: 2025 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Hand-written from the SafeParcelable definition of the same name in microG
+ * GmsCore (play-services-basement) so the trusted vault backend can read the
+ * result of a Folsom service call without the Play services SDK. Field
+ * numbers and the wire format are part of the protocol and must not change:
+ * 1000 = version code (int), 1 = status code (int), 2 = status message
+ * (String), 3 = resolution (PendingIntent).
+ *
+ * This class lives in org.chromium.components.trusted_vault.gms instead of
+ * com.google.android.gms.common.api because the Play services basement jar
+ * already ships a Status under that name and R8 rejects the duplicate class
+ * at dex time. Only the Java package changed; the wire format above is
+ * untouched. The status is only ever read from a Parcel written by the
+ * service (microG), never written by this client, but writeToParcel mirrors
+ * the same layout for completeness.
+ */
+
+package org.chromium.components.trusted_vault.gms;
+
+import android.app.PendingIntent;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import org.chromium.components.trusted_vault.FolsomSafeParcel;
+
+/** The result of a GMS service call, as returned by the microG Folsom service. */
+public class Status implements Parcelable {
+    private int statusCode;
+    private String statusMessage;
+    private PendingIntent resolution;
+
+    public Status() {}
+
+    public Status(int statusCode, String statusMessage, PendingIntent resolution) {
+        this.statusCode = statusCode;
+        this.statusMessage = statusMessage;
+        this.resolution = resolution;
+    }
+
+    public int getStatusCode() {
+        return statusCode;
+    }
+
+    public String getStatusMessage() {
+        return statusMessage;
+    }
+
+    /** A pending intent that resolves the failure, or null when there is none. */
+    public PendingIntent getResolution() {
+        return resolution;
+    }
+
+    /** Returns true when a resolution intent is available. */
+    public boolean hasResolution() {
+        return resolution != null;
+    }
+
+    /** Returns true when the operation was successful (status code <= 0). */
+    public boolean isSuccess() {
+        return statusCode <= 0;
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(Parcel dest, int flags) {
+        int start = FolsomSafeParcel.beginObject(dest);
+        FolsomSafeParcel.writeInt(dest, 1000, 1);
+        FolsomSafeParcel.writeInt(dest, 1, statusCode);
+        FolsomSafeParcel.writeString(dest, 2, statusMessage, false);
+        FolsomSafeParcel.writeParcelable(dest, 3, resolution, flags, false);
+        FolsomSafeParcel.finishObject(dest, start);
+    }
+
+    public static final Creator<Status> CREATOR =
+            new Creator<Status>() {
+                @Override
+                public Status createFromParcel(Parcel source) {
+                    int end = FolsomSafeParcel.readObjectEnd(source);
+                    Status result = new Status();
+                    while (source.dataPosition() < end) {
+                        int header = source.readInt();
+                        switch (FolsomSafeParcel.getFieldId(header)) {
+                            case 1:
+                                result.statusCode = FolsomSafeParcel.readInt(source, header);
+                                break;
+                            case 2:
+                                result.statusMessage =
+                                        FolsomSafeParcel.readString(source, header);
+                                break;
+                            case 3:
+                                result.resolution =
+                                        FolsomSafeParcel.readParcelable(
+                                                source, header, PendingIntent.CREATOR);
+                                break;
+                            default:
+                                FolsomSafeParcel.skip(source, header);
+                                break;
+                        }
+                    }
+                    source.setDataPosition(end);
+                    return result;
+                }
+
+                @Override
+                public Status[] newArray(int size) {
+                    return new Status[size];
+                }
+            };
+}
