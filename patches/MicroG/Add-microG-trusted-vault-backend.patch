+/*
+ * SPDX-FileCopyrightText: 2025 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Hand-written in the style of AIDL-generated code from the interface
+ * definition of the same name in microG GmsCore (play-services-basement) so
+ * the trusted vault backend can perform the GMS broker handshake with
+ * microG without the Play services SDK. The interface descriptor and the
+ * transaction number of getService (45) are part of the protocol and must
+ * not change. Only getService is declared: it is the single broker method
+ * this client uses. The server-side Stub is never implemented by this
+ * client (the broker lives in the microG process), so it is kept abstract.
+ *
+ * This interface lives in org.chromium.components.trusted_vault.gms instead
+ * of com.google.android.gms.common.internal because the Play services
+ * basement jar already ships an IGmsServiceBroker (and Stub) under that
+ * name and R8 rejects the duplicate class at dex time. The real basement
+ * Stub cannot be used here: it has no asInterface method, so the broker
+ * binder cannot be wrapped with it. Only the Java package changed; the
+ * descriptor string and transaction number above are untouched.
+ */
+
+package org.chromium.components.trusted_vault.gms;
+
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+public interface IGmsServiceBroker extends IInterface {
+    void getService(IGmsCallbacks callback, GetServiceRequest request) throws RemoteException;
+
+    abstract class Stub extends Binder implements IGmsServiceBroker {
+        private static final String DESCRIPTOR =
+                "com.google.android.gms.common.internal.IGmsServiceBroker";
+
+        static final int TRANSACTION_getService = IBinder.FIRST_CALL_TRANSACTION + 45;
+
+        public Stub() {
+            attachInterface(this, DESCRIPTOR);
+        }
+
+        public static IGmsServiceBroker asInterface(IBinder binder) {
+            if (binder == null) {
+                return null;
+            }
+            IInterface local = binder.queryLocalInterface(DESCRIPTOR);
+            if (local instanceof IGmsServiceBroker) {
+                return (IGmsServiceBroker) local;
+            }
+            return new Proxy(binder);
+        }
+
+        @Override
+        public IBinder asBinder() {
+            return this;
+        }
+
+        @Override
+        public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            // Client-side only: this process never hosts the broker.
+            return super.onTransact(code, data, reply, flags);
+        }
+
+        private static class Proxy implements IGmsServiceBroker {
+            private final IBinder mRemote;
+
+            Proxy(IBinder remote) {
+                mRemote = remote;
+            }
+
+            @Override
+            public IBinder asBinder() {
+                return mRemote;
+            }
+
+            @Override
+            public void getService(IGmsCallbacks callback, GetServiceRequest request)
+                    throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeStrongBinder(callback != null ? callback.asBinder() : null);
+                    if (request != null) {
+                        data.writeInt(1);
+                        request.writeToParcel(data, 0);
+                    } else {
+                        data.writeInt(0);
+                    }
+                    mRemote.transact(TRANSACTION_getService, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+        }
+    }
+}
