+                    int end = FolsomSafeParcel.readObjectEnd(source);
+                    ConnectionInfo result = new ConnectionInfo();
+                    while (source.dataPosition() < end) {
+                        int header = source.readInt();
+                        switch (FolsomSafeParcel.getFieldId(header)) {
+                            case 1:
+                                result.params =
+                                        FolsomSafeParcel.readBundle(
+                                                source,
+                                                header,
+                                                ConnectionInfo.class.getClassLoader());
+                                break;
+                            case 3:
+                                result.unknown3 = FolsomSafeParcel.readInt(source, header);
+                                break;
+                            default:
+                                FolsomSafeParcel.skip(source, header);
+                                break;
