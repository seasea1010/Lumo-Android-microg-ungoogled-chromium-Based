+package org.chromium.components.trusted_vault;
+
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/**
+ * Minimal reader/writer for the GMS "SafeParcel" serialization format, wire-compatible with the
+ * implementation used by microG (com.google.android.gms.common.internal.safeparcel). The format
+ * prefixes every field with a header int whose low 16 bits hold the field id and whose high 16
+ * bits hold the field size in bytes (0xFFFF meaning the size follows as a separate int). Objects
+ * start with a header whose field id is {@link #OBJECT_MAGIC} and whose size covers all field
+ * bytes that follow.
+ *
+ * <p>Only the field types needed by the trusted vault Folsom client are supported. Readers are
+ * written so that unknown fields can be skipped by size, which keeps them forward compatible
+ * with fields this client does not model.
+ */
+public final class FolsomSafeParcel {
+    public static final int OBJECT_MAGIC = 0x4F45;
+
+    private FolsomSafeParcel() {}
+
+    // ---------------------------------------------------------------------------------------------
+    // Writing
+    // ---------------------------------------------------------------------------------------------
+
+    private static void writeHeader(Parcel parcel, int fieldId, int size) {
+        if (size >= 0xFFFF) {
+            parcel.writeInt(0xFFFF0000 | fieldId);
+            parcel.writeInt(size);
+        } else {
+            parcel.writeInt((size << 16) | fieldId);
+        }
+    }
+
+    /** Writes an object header with a placeholder size; returns the position to pass to {@link
+     * #finishObject}. */
+    public static int beginObject(Parcel parcel) {
+        return beginField(parcel, OBJECT_MAGIC);
+    }
+
+    /** Writes a field header with a placeholder size for variable-length data. */
+    public static int beginField(Parcel parcel, int fieldId) {
+        writeHeader(parcel, fieldId, 0xFFFF);
+        return parcel.dataPosition();
+    }
+
+    public static void finishObject(Parcel parcel, int start) {
+        int end = parcel.dataPosition();
+        int length = end - start;
+        parcel.setDataPosition(start - 4);
+        parcel.writeInt(length);
+        parcel.setDataPosition(end);
+    }
+
+    public static void writeInt(Parcel parcel, int fieldId, int value) {
+        writeHeader(parcel, fieldId, 4);
+        parcel.writeInt(value);
+    }
+
+    public static void writeLong(Parcel parcel, int fieldId, long value) {
+        writeHeader(parcel, fieldId, 8);
+        parcel.writeLong(value);
+    }
+
+    public static void writeBoolean(Parcel parcel, int fieldId, boolean value) {
+        writeHeader(parcel, fieldId, 4);
+        parcel.writeInt(value ? 1 : 0);
+    }
+
+    public static void writeString(Parcel parcel, int fieldId, String value, boolean mayNull) {
+        if (value == null) {
+            if (mayNull) writeHeader(parcel, fieldId, 0);
+            return;
+        }
+        int start = beginField(parcel, fieldId);
+        parcel.writeString(value);
+        finishObject(parcel, start);
+    }
+
+    public static void writeByteArray(Parcel parcel, int fieldId, byte[] value, boolean mayNull) {
+        if (value == null) {
+            if (mayNull) writeHeader(parcel, fieldId, 0);
+            return;
+        }
+        int start = beginField(parcel, fieldId);
+        parcel.writeByteArray(value);
+        finishObject(parcel, start);
+    }
+
+    public static void writeBundle(Parcel parcel, int fieldId, Bundle value, boolean mayNull) {
+        if (value == null) {
+            if (mayNull) writeHeader(parcel, fieldId, 0);
+            return;
+        }
+        int start = beginField(parcel, fieldId);
+        parcel.writeBundle(value);
+        finishObject(parcel, start);
+    }
+
+    public static void writeBinder(Parcel parcel, int fieldId, IBinder value, boolean mayNull) {
+        if (value == null) {
+            if (mayNull) writeHeader(parcel, fieldId, 0);
+            return;
+        }
+        int start = beginField(parcel, fieldId);
+        parcel.writeStrongBinder(value);
+        finishObject(parcel, start);
+    }
+
+    public static void writeParcelable(
+            Parcel parcel, int fieldId, Parcelable value, int flags, boolean mayNull) {
+        if (value == null) {
+            if (mayNull) writeHeader(parcel, fieldId, 0);
+            return;
+        }
+        int start = beginField(parcel, fieldId);
+        value.writeToParcel(parcel, flags);
+        finishObject(parcel, start);
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Reading
+    // ---------------------------------------------------------------------------------------------
+
+    public static int getFieldId(int header) {
+        return header & 0xFFFF;
+    }
+
+    /** Reads the size for a field whose header was already read; consumes the extra size int
+     * when the header uses the 0xFFFF escape. */
+    public static int readSize(Parcel parcel, int header) {
+        if ((header & 0xFFFF0000) != 0xFFFF0000) {
+            return (header >> 16) & 0xFFFF;
+        }
+        return parcel.readInt();
+    }
+
+    /** Reads an object header and returns the absolute end position of the object. */
+    public static int readObjectEnd(Parcel parcel) {
+        int header = parcel.readInt();
+        int size = readSize(parcel, header);
+        int start = parcel.dataPosition();
+        if (getFieldId(header) != OBJECT_MAGIC) {
+            throw new IllegalArgumentException(
+                    "Expected object header, got 0x" + Integer.toHexString(header));
+        }
+        int end = start + size;
+        if (end < start || end > parcel.dataSize()) {
+            throw new IllegalArgumentException("Invalid object size " + size);
+        }
+        return end;
+    }
+
+    private static void readExpectedSize(Parcel parcel, int header, int expectedSize) {
+        int size = readSize(parcel, header);
+        if (size != expectedSize) {
+            throw new IllegalArgumentException(
+                    "Expected size " + expectedSize + ", got " + size);
+        }
+    }
+
+    public static int readInt(Parcel parcel, int header) {
+        readExpectedSize(parcel, header, 4);
+        return parcel.readInt();
+    }
+
+    public static long readLong(Parcel parcel, int header) {
+        readExpectedSize(parcel, header, 8);
+        return parcel.readLong();
+    }
+
+    public static boolean readBoolean(Parcel parcel, int header) {
+        readExpectedSize(parcel, header, 4);
+        return parcel.readInt() != 0;
+    }
+
+    public static String readString(Parcel parcel, int header) {
+        int size = readSize(parcel, header);
+        if (size == 0) return null;
+        int start = parcel.dataPosition();
+        String value = parcel.readString();
+        parcel.setDataPosition(start + size);
+        return value;
+    }
+
+    public static byte[] readByteArray(Parcel parcel, int header) {
+        int size = readSize(parcel, header);
+        if (size == 0) return null;
+        int start = parcel.dataPosition();
+        byte[] value = parcel.createByteArray();
+        parcel.setDataPosition(start + size);
+        return value;
+    }
+
+    public static Bundle readBundle(Parcel parcel, int header, ClassLoader classLoader) {
+        int size = readSize(parcel, header);
+        if (size == 0) return null;
+        int start = parcel.dataPosition();
+        Bundle value = parcel.readBundle(classLoader);
+        parcel.setDataPosition(start + size);
+        return value;
+    }
+
+    public static IBinder readBinder(Parcel parcel, int header) {
+        int size = readSize(parcel, header);
+        if (size == 0) return null;
+        int start = parcel.dataPosition();
+        IBinder value = parcel.readStrongBinder();
+        parcel.setDataPosition(start + size);
+        return value;
+    }
+
+    public static <T extends Parcelable> T readParcelable(
+            Parcel parcel, int header, Parcelable.Creator<T> creator) {
+        int size = readSize(parcel, header);
+        if (size == 0) return null;
+        int start = parcel.dataPosition();
+        T value = creator.createFromParcel(parcel);
+        parcel.setDataPosition(start + size);
+        return value;
+    }
+
+    public static void skip(Parcel parcel, int header) {
+        int size = readSize(parcel, header);
+        parcel.setDataPosition(parcel.dataPosition() + size);
+    }
+}
