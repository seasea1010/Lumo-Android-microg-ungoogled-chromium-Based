diff --git a/components/trusted_vault/android/java/src/com/google/android/gms/auth/folsom/SharedKey.java b/components/trusted_vault/android/java/src/com/google/android/gms/auth/folsom/SharedKey.java
new file mode 100644
index 0000000000000..ca93806cadacc
--- /dev/null
+++ b/components/trusted_vault/android/java/src/com/google/android/gms/auth/folsom/SharedKey.java
@@ -0,0 +1,74 @@
+/*
+ * SPDX-FileCopyrightText: 2025 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Hand-written from the SafeParcelable definition of the same name in microG
+ * GmsCore (play-services-auth-base) so the trusted vault backend can receive
+ * key material from the microG Folsom service without the Play services SDK.
+ * Field numbers and the wire format are part of the protocol and must not
+ * change: 1 = key version (int), 2 = key material (byte[]).
+ */
+
+package com.google.android.gms.auth.folsom;
+
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import org.chromium.components.trusted_vault.FolsomSafeParcel;
+
+/** A single trusted vault shared key as returned by the Folsom service. */
+public class SharedKey implements Parcelable {
+    public int key;
+    public byte[] keyMaterial;
+
+    public SharedKey() {}
+
+    public SharedKey(int key, byte[] keyMaterial) {
+        this.key = key;
+        this.keyMaterial = keyMaterial;
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(Parcel dest, int flags) {
+        int start = FolsomSafeParcel.beginObject(dest);
+        FolsomSafeParcel.writeInt(dest, 1, key);
+        FolsomSafeParcel.writeByteArray(dest, 2, keyMaterial, false);
+        FolsomSafeParcel.finishObject(dest, start);
+    }
+
+    public static final Creator<SharedKey> CREATOR =
+            new Creator<SharedKey>() {
+                @Override
+                public SharedKey createFromParcel(Parcel source) {
+                    int end = FolsomSafeParcel.readObjectEnd(source);
+                    SharedKey result = new SharedKey();
+                    while (source.dataPosition() < end) {
+                        int header = source.readInt();
+                        switch (FolsomSafeParcel.getFieldId(header)) {
+                            case 1:
+                                result.key = FolsomSafeParcel.readInt(source, header);
+                                break;
+                            case 2:
+                                result.keyMaterial =
+                                        FolsomSafeParcel.readByteArray(source, header);
+                                break;
+                            default:
+                                FolsomSafeParcel.skip(source, header);
+                                break;
+                        }
+                    }
+                    source.setDataPosition(end);
+                    return result;
+                }
+
+                @Override
+                public SharedKey[] newArray(int size) {
+                    return new SharedKey[size];
+                }
+            };
+}
diff --git a/components/trusted_vault/android/java/src/com/google/android/gms/auth/folsom/internal/IKeyRetrievalCallback.java b/components/trusted_vault/android/java/src/com/google/android/gms/auth/folsom/internal/IKeyRetrievalCallback.java
new file mode 100644
index 0000000000000..41d7547e24b46
--- /dev/null
+++ b/components/trusted_vault/android/java/src/com/google/android/gms/auth/folsom/internal/IKeyRetrievalCallback.java
@@ -0,0 +1,105 @@
+/*
+ * SPDX-FileCopyrightText: 2025 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Hand-written in the style of AIDL-generated code from the interface
+ * definition of the same name in microG GmsCore (play-services-auth-base) so
+ * the trusted vault backend can receive results from the microG Folsom
+ * service without the Play services SDK. The interface descriptor and
+ * transaction numbers are part of the protocol and must not change.
+ */
+
+package com.google.android.gms.auth.folsom.internal;
+
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+import org.chromium.components.trusted_vault.gms.Status;
+
+public interface IKeyRetrievalCallback extends IInterface {
+    void onResult(Status status) throws RemoteException;
+
+    abstract class Stub extends Binder implements IKeyRetrievalCallback {
+        private static final String DESCRIPTOR =
+                "com.google.android.gms.auth.folsom.internal.IKeyRetrievalCallback";
+
+        static final int TRANSACTION_onResult = IBinder.FIRST_CALL_TRANSACTION;
+
+        public Stub() {
+            attachInterface(this, DESCRIPTOR);
+        }
+
+        public static IKeyRetrievalCallback asInterface(IBinder binder) {
+            if (binder == null) {
+                return null;
+            }
+            IInterface local = binder.queryLocalInterface(DESCRIPTOR);
+            if (local instanceof IKeyRetrievalCallback) {
+                return (IKeyRetrievalCallback) local;
+            }
+            return new Proxy(binder);
+        }
+
+        @Override
+        public IBinder asBinder() {
+            return this;
+        }
+
+        @Override
+        public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            switch (code) {
+                case IBinder.INTERFACE_TRANSACTION: {
+                    reply.writeString(DESCRIPTOR);
+                    return true;
+                }
+                case TRANSACTION_onResult: {
+                    data.enforceInterface(DESCRIPTOR);
+                    Status status =
+                            data.readInt() != 0 ? Status.CREATOR.createFromParcel(data) : null;
+                    onResult(status);
+                    reply.writeNoException();
+                    return true;
+                }
+                default:
+                    return super.onTransact(code, data, reply, flags);
+            }
+        }
+
+        private static class Proxy implements IKeyRetrievalCallback {
+            private final IBinder mRemote;
+
+            Proxy(IBinder remote) {
+                mRemote = remote;
+            }
+
+            @Override
+            public IBinder asBinder() {
+                return mRemote;
+            }
+
+            @Override
+            public void onResult(Status status) throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    if (status != null) {
+                        data.writeInt(1);
+                        status.writeToParcel(data, 0);
+                    } else {
+                        data.writeInt(0);
+                    }
+                    mRemote.transact(TRANSACTION_onResult, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+        }
+    }
+}
diff --git a/components/trusted_vault/android/java/src/com/google/android/gms/auth/folsom/internal/IKeyRetrievalService.java b/components/trusted_vault/android/java/src/com/google/android/gms/auth/folsom/internal/IKeyRetrievalService.java
