--- /dev/null
+++ b/components/trusted_vault/android/java/src/org/chromium/components/trusted_vault/gms/IGmsCallbacks.java
@@ -0,0 +1,199 @@
+/*
+ * SPDX-FileCopyrightText: 2025 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Hand-written in the style of AIDL-generated code from the interface
+ * definition of the same name in microG GmsCore (play-services-basement) so
+ * the trusted vault backend can complete the GMS broker handshake with
+ * microG without the Play services SDK. The interface descriptor and
+ * transaction numbers are part of the protocol and must not change.
+ *
+ * This interface lives in org.chromium.components.trusted_vault.gms instead
+ * of com.google.android.gms.common.internal because the Play services
+ * basement jar already ships an IGmsCallbacks under that name and R8
+ * rejects the duplicate class at dex time. The real basement interface
+ * cannot be used here: it has no Stub and its methods are obfuscated
+ * (zzb/zzc), so the handshake callbacks cannot be implemented against it.
+ * Only the Java package changed; the descriptor string and transaction
+ * numbers above are untouched.
+ */
+
+package org.chromium.components.trusted_vault.gms;
+
+import android.os.Binder;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+import org.chromium.components.trusted_vault.gms.ConnectionInfo;
+
+public interface IGmsCallbacks extends IInterface {
+    void onPostInitComplete(int statusCode, IBinder binder, Bundle params) throws RemoteException;
+
+    void onAccountValidationComplete(int statusCode, Bundle params) throws RemoteException;
+
+    void onPostInitCompleteWithConnectionInfo(int statusCode, IBinder binder, ConnectionInfo info)
+            throws RemoteException;
+
+    abstract class Stub extends Binder implements IGmsCallbacks {
+        private static final String DESCRIPTOR = "com.google.android.gms.common.internal.IGmsCallbacks";
+
+        static final int TRANSACTION_onPostInitComplete = IBinder.FIRST_CALL_TRANSACTION;
+        static final int TRANSACTION_onAccountValidationComplete =
+                IBinder.FIRST_CALL_TRANSACTION + 1;
+        static final int TRANSACTION_onPostInitCompleteWithConnectionInfo =
+                IBinder.FIRST_CALL_TRANSACTION + 2;
+
+        public Stub() {
+            attachInterface(this, DESCRIPTOR);
+        }
+
+        public static IGmsCallbacks asInterface(IBinder binder) {
+            if (binder == null) {
+                return null;
+            }
+            IInterface local = binder.queryLocalInterface(DESCRIPTOR);
+            if (local instanceof IGmsCallbacks) {
+                return (IGmsCallbacks) local;
+            }
+            return new Proxy(binder);
+        }
+
+        @Override
+        public IBinder asBinder() {
+            return this;
+        }
+
+        @Override
+        public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            switch (code) {
+                case IBinder.INTERFACE_TRANSACTION: {
+                    reply.writeString(DESCRIPTOR);
+                    return true;
+                }
+                case TRANSACTION_onPostInitComplete: {
+                    data.enforceInterface(DESCRIPTOR);
+                    int statusCode = data.readInt();
+                    IBinder binder = data.readStrongBinder();
+                    // The bundle argument is not used by this client; read it defensively so a
+                    // malformed or absent bundle cannot break the handshake.
+                    Bundle params = null;
+                    if (data.dataAvail() > 0) {
+                        try {
+                            params = data.readBundle(IGmsCallbacks.class.getClassLoader());
+                        } catch (Exception ignored) {
+                            params = null;
+                        }
+                    }
+                    onPostInitComplete(statusCode, binder, params);
+                    reply.writeNoException();
+                    return true;
+                }
+                case TRANSACTION_onAccountValidationComplete: {
+                    data.enforceInterface(DESCRIPTOR);
+                    int statusCode = data.readInt();
+                    Bundle params = null;
+                    if (data.dataAvail() > 0) {
+                        try {
+                            params = data.readBundle(IGmsCallbacks.class.getClassLoader());
+                        } catch (Exception ignored) {
+                            params = null;
+                        }
+                    }
+                    onAccountValidationComplete(statusCode, params);
+                    reply.writeNoException();
+                    return true;
+                }
+                case TRANSACTION_onPostInitCompleteWithConnectionInfo: {
+                    data.enforceInterface(DESCRIPTOR);
+                    int statusCode = data.readInt();
+                    IBinder binder = data.readStrongBinder();
+                    ConnectionInfo info =
+                            data.readInt() != 0
+                                    ? ConnectionInfo.CREATOR.createFromParcel(data)
+                                    : null;
+                    onPostInitCompleteWithConnectionInfo(statusCode, binder, info);
+                    reply.writeNoException();
+                    return true;
+                }
+                default:
+                    return super.onTransact(code, data, reply, flags);
+            }
+        }
+
+        private static class Proxy implements IGmsCallbacks {
+            private final IBinder mRemote;
+
+            Proxy(IBinder remote) {
+                mRemote = remote;
+            }
+
+            @Override
+            public IBinder asBinder() {
+                return mRemote;
+            }
+
+            @Override
+            public void onPostInitComplete(int statusCode, IBinder binder, Bundle params)
+                    throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeInt(statusCode);
+                    data.writeStrongBinder(binder);
+                    data.writeBundle(params);
+                    mRemote.transact(TRANSACTION_onPostInitComplete, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+
+            @Override
+            public void onAccountValidationComplete(int statusCode, Bundle params)
+                    throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeInt(statusCode);
+                    data.writeBundle(params);
+                    mRemote.transact(TRANSACTION_onAccountValidationComplete, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+
+            @Override
+            public void onPostInitCompleteWithConnectionInfo(
+                    int statusCode, IBinder binder, ConnectionInfo info) throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeInt(statusCode);
+                    data.writeStrongBinder(binder);
+                    if (info != null) {
+                        data.writeInt(1);
+                        info.writeToParcel(data, 0);
+                    } else {
+                        data.writeInt(0);
+                    }
+                    mRemote.transact(
+                            TRANSACTION_onPostInitCompleteWithConnectionInfo, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+        }
+    }
+}
