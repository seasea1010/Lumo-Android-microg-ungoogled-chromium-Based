+/*
+ * SPDX-FileCopyrightText: 2025 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Hand-written from the SafeParcelable definition of the same name in microG
+ * GmsCore (play-services-basement) so the trusted vault backend can receive
+ * the GMS broker handshake result from microG without the Play services SDK.
+ * Field numbers and the wire format are part of the protocol and must not
+ * change: 1 = params (Bundle), 2 = features (Feature[], not modelled by this
+ * client; skipped when reading), 3 = int.
+ *
+ * This class lives in org.chromium.components.trusted_vault.gms instead of
+ * com.google.android.gms.common.internal because the Play services basement
+ * jar already ships a ConnectionInfo under that name and R8 rejects the
+ * duplicate class at dex time. Only the Java package changed; the wire
+ * format above is untouched.
+ */
+
+package org.chromium.components.trusted_vault.gms;
+
+import android.os.Bundle;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import org.chromium.components.trusted_vault.FolsomSafeParcel;
+
+public class ConnectionInfo implements Parcelable {
+    public Bundle params;
+    public int unknown3;
+
+    public ConnectionInfo() {}
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(Parcel dest, int flags) {
