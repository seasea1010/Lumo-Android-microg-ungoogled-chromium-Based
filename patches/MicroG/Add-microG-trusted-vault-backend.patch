diff --git a/components/trusted_vault/android/java/src/org/chromium/components/trusted_vault/gms/ApiMetadata.java b/components/trusted_vault/android/java/src/org/chromium/components/trusted_vault/gms/ApiMetadata.java
new file mode 100644
index 0000000000000..2936711885193b78e7e4413cadfa35957660fd00
--- /dev/null
+++ b/components/trusted_vault/android/java/src/org/chromium/components/trusted_vault/gms/ApiMetadata.java
@@ -0,0 +1,66 @@
+/*
+ * SPDX-FileCopyrightText: 2025 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Minimal stand-in for the SafeParcelable of the same name in microG GmsCore
+ * (play-services-basement). The trusted vault backend always passes null
+ * metadata to the Folsom service (microG accepts null), so this class is
+ * only ever a compile-time type and is never written to a Parcel by this
+ * client; the write path below mirrors microG's layout (a magic int
+ * followed by an empty SafeParcel object) so that a non-null value would
+ * still parse on the service side. Field numbers are part of the protocol
+ * and must not change: 1 = compliance options, 2 = boolean.
+ *
+ * This class lives in org.chromium.components.trusted_vault.gms instead of
+ * com.google.android.gms.common.api because the Play services basement jar
+ * already ships an ApiMetadata under that name and R8 rejects the duplicate
+ * class at dex time. Only the Java package changed; the wire format above
+ * is untouched.
+ */
+
+package org.chromium.components.trusted_vault.gms;
+
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import org.chromium.components.trusted_vault.FolsomSafeParcel;
+
+/** Optional metadata attached to a Folsom service call; always null in practice. */
+public class ApiMetadata implements Parcelable {
+    // Magic written by microG before the object; the reader checks for it first.
+    private static final int METADATA_PRESENT_MAGIC = -204102970;
+
+    public ApiMetadata() {}
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(Parcel dest, int flags) {
+        dest.writeInt(METADATA_PRESENT_MAGIC);
+        int start = FolsomSafeParcel.beginObject(dest);
+        FolsomSafeParcel.finishObject(dest, start);
+    }
+
+    public static final Creator<ApiMetadata> CREATOR =
+            new Creator<ApiMetadata>() {
+                @Override
+                public ApiMetadata createFromParcel(Parcel source) {
+                    int startPosition = source.dataPosition();
+                    if (source.readInt() != METADATA_PRESENT_MAGIC) {
+                        source.setDataPosition(startPosition);
+                        return new ApiMetadata();
+                    }
+                    int end = FolsomSafeParcel.readObjectEnd(source);
+                    source.setDataPosition(end);
+                    return new ApiMetadata();
+                }
+
+                @Override
+                public ApiMetadata[] newArray(int size) {
+                    return new ApiMetadata[size];
+                }
+            };
+}
