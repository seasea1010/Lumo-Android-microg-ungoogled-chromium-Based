index 0000000000000..780e14a416fa9
--- /dev/null
+++ b/components/trusted_vault/android/java/src/com/google/android/gms/auth/folsom/internal/IKeyRetrievalService.java
@@ -0,0 +1,157 @@
+/*
+ * SPDX-FileCopyrightText: 2025 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Hand-written in the style of AIDL-generated code from the interface
+ * definition of the same name in microG GmsCore (play-services-auth-base) so
+ * the trusted vault backend can talk to the microG Folsom service without
+ * the Play services SDK. The interface descriptor and the transaction
+ * numbers assigned by the AIDL definition (markLocalKeysAsStale = 3,
+ * getKeyMaterial = 4, startUxFlow = 11) are part of the protocol and must
+ * not change. Only the three methods used by the trusted vault backend are
+ * declared; the full AIDL defines additional methods this client never
+ * calls. The server-side Stub is never implemented by this client (the
+ * service lives in the microG process), so it is kept abstract.
+ */
+
+package com.google.android.gms.auth.folsom.internal;
+
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+import org.chromium.components.trusted_vault.gms.ApiMetadata;
+
+public interface IKeyRetrievalService extends IInterface {
+    void markLocalKeysAsStale(
+            IKeyRetrievalCallback callback, String accountName, ApiMetadata metadata)
+            throws RemoteException;
+
+    void getKeyMaterial(ISharedKeyCallback callback, String accountName, ApiMetadata metadata)
+            throws RemoteException;
+
+    void startUxFlow(
+            IKeyRetrievalCallback callback, String accountName, int type, ApiMetadata metadata)
+            throws RemoteException;
+
+    abstract class Stub extends Binder implements IKeyRetrievalService {
+        private static final String DESCRIPTOR =
+                "com.google.android.gms.auth.folsom.internal.IKeyRetrievalService";
+
+        static final int TRANSACTION_markLocalKeysAsStale = IBinder.FIRST_CALL_TRANSACTION + 3;
+        static final int TRANSACTION_getKeyMaterial = IBinder.FIRST_CALL_TRANSACTION + 4;
+        static final int TRANSACTION_startUxFlow = IBinder.FIRST_CALL_TRANSACTION + 11;
+
+        public Stub() {
+            attachInterface(this, DESCRIPTOR);
+        }
+
+        public static IKeyRetrievalService asInterface(IBinder binder) {
+            if (binder == null) {
+                return null;
+            }
+            IInterface local = binder.queryLocalInterface(DESCRIPTOR);
+            if (local instanceof IKeyRetrievalService) {
+                return (IKeyRetrievalService) local;
+            }
+            return new Proxy(binder);
+        }
+
+        @Override
+        public IBinder asBinder() {
+            return this;
+        }
+
+        @Override
+        public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            // Client-side only: this process never hosts the key retrieval service.
+            return super.onTransact(code, data, reply, flags);
+        }
+
+        private static void writeMetadata(Parcel data, ApiMetadata metadata) {
+            if (metadata != null) {
+                data.writeInt(1);
+                metadata.writeToParcel(data, 0);
+            } else {
+                data.writeInt(0);
+            }
+        }
+
+        private static class Proxy implements IKeyRetrievalService {
+            private final IBinder mRemote;
+
+            Proxy(IBinder remote) {
+                mRemote = remote;
+            }
+
+            @Override
+            public IBinder asBinder() {
+                return mRemote;
+            }
+
+            @Override
+            public void markLocalKeysAsStale(
+                    IKeyRetrievalCallback callback, String accountName, ApiMetadata metadata)
+                    throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeStrongBinder(callback != null ? callback.asBinder() : null);
+                    data.writeString(accountName);
+                    writeMetadata(data, metadata);
+                    mRemote.transact(TRANSACTION_markLocalKeysAsStale, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+
+            @Override
+            public void getKeyMaterial(
+                    ISharedKeyCallback callback, String accountName, ApiMetadata metadata)
+                    throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeStrongBinder(callback != null ? callback.asBinder() : null);
+                    data.writeString(accountName);
+                    writeMetadata(data, metadata);
+                    mRemote.transact(TRANSACTION_getKeyMaterial, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+
+            @Override
+            public void startUxFlow(
+                    IKeyRetrievalCallback callback,
+                    String accountName,
+                    int type,
+                    ApiMetadata metadata)
+                    throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeStrongBinder(callback != null ? callback.asBinder() : null);
+                    data.writeString(accountName);
+                    data.writeInt(type);
+                    writeMetadata(data, metadata);
+                    mRemote.transact(TRANSACTION_startUxFlow, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+        }
+    }
+}
