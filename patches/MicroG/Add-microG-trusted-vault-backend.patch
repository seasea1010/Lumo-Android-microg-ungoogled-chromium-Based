@@ -0,0 +1,111 @@
+/*
+ * SPDX-FileCopyrightText: 2025 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Hand-written from the SafeParcelable definition of the same name in microG
+ * GmsCore (play-services-basement) so the trusted vault backend can perform
+ * the GMS broker handshake with microG without the Play services SDK. Field
+ * numbers and the wire format are part of the protocol and must not change:
+ * 1 = version code (int), 2 = service id (int), 3 = GMS version (int),
+ * 4 = package name (String), 5 = account accessor (binder), 6 = scopes,
+ * 7 = extras (Bundle), 8 = account, 9 = (deprecated long), 10/11 = features,
+ * 12 = supports connection info (boolean), 13 = int, 14 = boolean,
+ * 15 = attribution tag (String). This client only sets the fields the Folsom
+ * handshake needs; the rest are written with their default values or omitted
+ * (absent reference fields read back as null on the service side).
+ *
+ * This class lives in org.chromium.components.trusted_vault.gms instead of
+ * com.google.android.gms.common.internal because the Play services basement
+ * jar already ships a GetServiceRequest under that name and R8 rejects the
+ * duplicate class at dex time. The real basement class cannot be used here:
+ * it has no public constructor and no public packageName/extras fields, so
+ * the handshake request cannot be built with it. Only the Java package
+ * changed; the wire format above is untouched.
+ */
+
+package org.chromium.components.trusted_vault.gms;
+
+import android.os.Bundle;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import org.chromium.components.trusted_vault.FolsomSafeParcel;
+
+public class GetServiceRequest implements Parcelable {
+    private static final int VERSION_CODE = 6;
+    // GMS version code of the microG generation this client targets. The broker
+    // does not branch on this value for the Folsom service.
+    private static final int GMS_VERSION_CODE = 252432000;
+
+    public int serviceId;
+    public String packageName;
+    public Bundle extras;
+    public boolean supportsConnectionInfo = true;
+
+    public GetServiceRequest(int serviceId) {
+        this.serviceId = serviceId;
+    }
+
+    private GetServiceRequest() {}
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(Parcel dest, int flags) {
+        int start = FolsomSafeParcel.beginObject(dest);
+        FolsomSafeParcel.writeInt(dest, 1, VERSION_CODE);
+        FolsomSafeParcel.writeInt(dest, 2, serviceId);
+        FolsomSafeParcel.writeInt(dest, 3, GMS_VERSION_CODE);
+        FolsomSafeParcel.writeString(dest, 4, packageName, false);
+        FolsomSafeParcel.writeBundle(dest, 7, extras, false);
+        FolsomSafeParcel.writeLong(dest, 9, 0);
+        FolsomSafeParcel.writeBoolean(dest, 12, supportsConnectionInfo);
+        FolsomSafeParcel.writeInt(dest, 13, 0);
+        FolsomSafeParcel.writeBoolean(dest, 14, false);
+        FolsomSafeParcel.finishObject(dest, start);
+    }
+
+    public static final Creator<GetServiceRequest> CREATOR =
+            new Creator<GetServiceRequest>() {
+                @Override
+                public GetServiceRequest createFromParcel(Parcel source) {
+                    int end = FolsomSafeParcel.readObjectEnd(source);
+                    GetServiceRequest result = new GetServiceRequest();
+                    while (source.dataPosition() < end) {
+                        int header = source.readInt();
+                        switch (FolsomSafeParcel.getFieldId(header)) {
+                            case 2:
+                                result.serviceId = FolsomSafeParcel.readInt(source, header);
+                                break;
+                            case 4:
+                                result.packageName = FolsomSafeParcel.readString(source, header);
+                                break;
+                            case 7:
+                                result.extras =
+                                        FolsomSafeParcel.readBundle(
+                                                source,
+                                                header,
+                                                GetServiceRequest.class.getClassLoader());
+                                break;
+                            case 12:
+                                result.supportsConnectionInfo =
+                                        FolsomSafeParcel.readBoolean(source, header);
+                                break;
+                            default:
+                                FolsomSafeParcel.skip(source, header);
+                                break;
+                        }
+                    }
+                    source.setDataPosition(end);
+                    return result;
+                }
+
+                @Override
+                public GetServiceRequest[] newArray(int size) {
+                    return new GetServiceRequest[size];
+                }
+            };
+}
