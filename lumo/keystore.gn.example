# ローカルビルド用の署名設定サンプル。
# 使い方: 土台リポジトリの2つ上の階層に uc_keystore/ ディレクトリを作り、
#         keystore.gn という名前でこの内容を置くと、build.sh が args.gn へ連結する。
# GitHub ホストのビルドでは使わない（Secrets KEYSTORE_B64 / KEYSTORE_PASS から投入される）。
# 実在のパスやパスワードはここに書かないこと。

android_keystore_path = "/path/to/lumo-android-release.jks"
android_keystore_name = "key0"
android_keystore_password = "CHANGE_ME"
